# NeuroTrack Server Environment Variables
# Copy this file to .env and fill in your values

# ── SMTP Email Config (for OTP emails) ──
# If not set, the server runs in DEMO mode (OTP shown on screen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# For Gmail: enable 2FA and generate an App Password at:
# https://myaccount.google.com/apppasswords

# For other providers:
# Outlook: smtp-mail.outlook.com | port 587
# Yahoo:   smtp.mail.yahoo.com   | port 587
# Resend:  smtp.resend.com       | port 587  (recommended for production)

# ── Server ──
PORT=5000
